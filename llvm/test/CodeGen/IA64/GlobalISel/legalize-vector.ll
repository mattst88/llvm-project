  ; CHECK-NEXT:   [[C2:%[0-9]+]]:_(s64) = G_CONSTANT i64 1
  ; CHECK-NEXT:   [[PTR_ADD2:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD [[COPY]], [[C2]](s64)
  ; CHECK-NEXT:   [[SEXT_INREG3:%[0-9]+]]:_(s64) = G_SEXT_INREG [[LOAD1]], 16
  ; CHECK-NEXT:   G_STORE [[SEXT_INREG3]](s64), [[PTR_ADD2]](p0) :: (store (s8) into %ir.p + 1, basealign 2)
  ; CHECK-NEXT:   BR_RET $b0, 0, 1, 0, $p0
  %v = load <2 x i16>, ptr %p
  %w = sext <2 x i16> %v to <2 x i32>
  %f = sitofp <2 x i32> %w to <2 x double>
  %t = trunc <2 x i32> %w to <2 x i8>
  store <2 x double> %f, ptr %q
  store <2 x i8> %t, ptr %p
  ret void
}
