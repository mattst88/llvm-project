# RUN: llc -mtriple=ia64-unknown-linux-gnu -start-before=ia64-insert-stops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# The group continues past two labels, each of which starts a bundle. The
# first bundle fills both I ports, so the bundle at .LBB0_1 issues in the
# same cycle only as MMI, where the assembler would choose MII.

# CHECK-LABEL: carry:
# CHECK:       add r16 = r32, r35
# CHECK-NEXT:  .LBB0_1:
# CHECK-NEXT:  // Child Loop
# CHECK-NEXT:  .mmi
# CHECK-NEXT:  adds r17 = -1, r33
# CHECK-NEXT:  mov r18 = r32
# CHECK-NEXT:  .LBB0_2:
---
name: carry
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r32, $r33, $r34, $r35, $b0

    $r14 = SHLADD $r32, 2, $r33, $p0
    $r15 = ADD $r32, $r34, $p0
    $r16 = ADD $r32, $r35, $p0

  bb.1:
    successors: %bb.2
    liveins: $r14, $r15, $r16, $r32, $r33, $b0

    $r17 = ADDS -1, $r33, $p0
    $r18 = ADDS 0, $r32, $p0

  bb.2:
    successors: %bb.1, %bb.3
    liveins: $r14, $r15, $r16, $r32, $r33, $b0

    $r19 = ADDS 36, $r32, $p0
    $r20 = ADDS 40, $r0, $p0
    $r21 = ADDS 32, $r32, $p0
    $p6, $p7 = CMP_EQ $r19, $r0, $p0
    BR_COND %bb.1, 2, 0, 0, $p6

  bb.3:
    successors: %bb.2, %bb.4
    liveins: $r14, $r15, $r16, $r32, $r33, $b0

    $p6, $p7 = CMP_EQ $r14, $r0, $p0
    BR_COND %bb.2, 2, 0, 0, $p6

  bb.4:
    liveins: $r14, $r15, $b0

    $r8 = ADD killed $r14, killed $r15, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8
...
