; for (j = 0; j < n; j++) p[j] = (i + j) * (i + j + 1);
; The product grows by 2 * (i + j + 1) each iteration.
define void @quadratic(ptr %p, i32 %i, i64 %n) {
; CHECK-LABEL: define void @quadratic(
; CHECK-SAME: ptr [[P:%.*]], i32 [[I:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[I1:%.*]] = add i32 [[I]], 1
; CHECK-NEXT:    [[TMP0:%.*]] = mul i32 [[I]], [[I1]]
; CHECK-NEXT:    [[TMP1:%.*]] = shl i32 [[I]], 1
; CHECK-NEXT:    [[TMP2:%.*]] = add i32 [[TMP1]], 2
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[J_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[M_REC:%.*]] = phi i32 [ [[TMP0]], %[[ENTRY]] ], [ [[M_REC_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[M_STEP:%.*]] = phi i32 [ [[TMP2]], %[[ENTRY]] ], [ [[M_STEP_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[J32:%.*]] = trunc i64 [[J]] to i32
; CHECK-NEXT:    [[A:%.*]] = add i32 [[I]], [[J32]]
; CHECK-NEXT:    [[B:%.*]] = add i32 [[I1]], [[J32]]
; CHECK-NEXT:    [[PJ:%.*]] = getelementptr inbounds i32, ptr [[P]], i64 [[J]]
; CHECK-NEXT:    store i32 [[M_REC]], ptr [[PJ]], align 4
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[J_NEXT]], [[N]]
; CHECK-NEXT:    [[M_REC_NEXT]] = add i32 [[M_REC]], [[M_STEP]]
; CHECK-NEXT:    [[M_STEP_NEXT]] = add i32 [[M_STEP]], 2
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %i1 = add i32 %i, 1
  br label %loop
loop:
  %j = phi i64 [ 0, %entry ], [ %j.next, %loop ]
  %j32 = trunc i64 %j to i32
  %a = add i32 %i, %j32
  %b = add i32 %i1, %j32
  %m = mul i32 %a, %b
  %pj = getelementptr inbounds i32, ptr %p, i64 %j
  store i32 %m, ptr %pj
  %j.next = add nuw nsw i64 %j, 1
  %done = icmp eq i64 %j.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret void
}

