; CHECK-NEXT:    [[S:%.*]] = phi i32 [ 0, %[[OUTER]] ], [ [[S_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[M_REC:%.*]] = phi i32 [ [[IA64_MULREC_IV]], %[[OUTER]] ], [ [[M_REC_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[M_STEP:%.*]] = phi i32 [ [[TMP2]], %[[OUTER]] ], [ [[M_STEP_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[J32:%.*]] = trunc i64 [[J]] to i32
; CHECK-NEXT:    [[A:%.*]] = add i32 [[I32]], [[J32]]
; CHECK-NEXT:    [[S_NEXT]] = add i32 [[S]], [[M_REC]]
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[JDONE:%.*]] = icmp eq i64 [[J_NEXT]], [[N]]
; CHECK-NEXT:    [[M_REC_NEXT]] = add i32 [[M_REC]], [[M_STEP]]
; CHECK-NEXT:    [[M_STEP_NEXT]] = add i32 [[M_STEP]], 2
; CHECK-NEXT:    br i1 [[JDONE]], label %[[LATCH]], label %[[INNER]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[PI:%.*]] = getelementptr inbounds i32, ptr [[P]], i64 [[I]]
; CHECK-NEXT:    store i32 [[S_NEXT]], ptr [[PI]], align 4
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[IDONE:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    [[IA64_MULREC_IV_NEXT]] = add i32 [[IA64_MULREC_IV]], [[TMP2]]
; CHECK-NEXT:    br i1 [[IDONE]], label %[[EXIT]], label %[[OUTER]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
