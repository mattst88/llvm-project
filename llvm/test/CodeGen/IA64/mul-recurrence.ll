  %a = add i32 %i32, %j32
  %m = mul i32 %a, %a
  %s.next = add i32 %s, %m
  %j.next = add nuw nsw i64 %j, 1
  %jdone = icmp eq i64 %j.next, %n
  br i1 %jdone, label %latch, label %inner
latch:
  %pi = getelementptr inbounds i32, ptr %p, i64 %i
  store i32 %s.next, ptr %pi
  %i.next = add nuw nsw i64 %i, 1
  %idone = icmp eq i64 %i.next, %n
  br i1 %idone, label %exit, label %outer
