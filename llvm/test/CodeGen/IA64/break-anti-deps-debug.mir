# RUN: llc -mtriple=ia64-unknown-linux-gnu -run-pass=ia64-break-anti-deps \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

# A renamed value's DBG_VALUEs follow it, and a DBG_LABEL in the span, which
# has no register operands to rename, is left alone.
# CHECK-LABEL: name: reuse
# CHECK:         $r14 = ADDS 8, $r32, $p0
# CHECK-NEXT:    $r16 = LD8 $r14, 0, $p0
# CHECK-NEXT:    $[[R:r[0-9]+]] = ADDS 16, $r32, $p0
# CHECK-NEXT:    DBG_LABEL
# CHECK-NEXT:    DBG_VALUE $[[R]]
# CHECK-NEXT:    $r17 = LD8 $[[R]], 0, $p0
--- |
  define i64 @reuse(ptr %p) !dbg !4 {
    ret i64 0
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, isOptimized: true, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "reuse", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !5 = !DISubroutineType(types: !6)
  !6 = !{}
  !7 = !DILabel(scope: !4, name: "here", file: !1, line: 2)
  !8 = !DILocalVariable(name: "q", scope: !4, file: !1, line: 2, type: !9)
  !9 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
  !10 = !DILocation(line: 2, column: 1, scope: !4)
...
---
name: reuse
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r32

    $r14 = ADDS 8, $r32, $p0
    $r16 = LD8 $r14, 0, $p0
    $r14 = ADDS 16, $r32, $p0
    DBG_LABEL !7, debug-location !10
    DBG_VALUE $r14, $noreg, !8, !DIExpression(), debug-location !10
    $r17 = LD8 $r14, 0, $p0
    $r8 = ADD $r16, $r17, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
