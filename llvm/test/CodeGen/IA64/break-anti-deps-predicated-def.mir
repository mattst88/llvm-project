# RUN: llc -mtriple=ia64-unknown-linux-gnu -run-pass=ia64-break-anti-deps \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

# A predicated write does not end the value its register held: where p6 is
# true, the (p7) write below does not execute and the store must still see
# the 20 that (p6) wrote.  The pass computes liveness with LivePhysRegs, whose
# stepBackward() takes every def as a kill, so r24 looks free between the two
# predicated writes, and the value the second LD2 loads is moved into it:
#
#   $r24 = ADDL 20, $r0, $p6
#   $r24 = LD2 $r32, 0, $p0        <- renamed from $r14: clobbers the 20
#   ST2 $r33, $r24, 0, $p0
#   $r24 = ADDS 0, $r0, $p7
#   ST1 $r32, $r24, 0, $p0         <- stores the loaded halfword where p6
#
# Every other scratch register is live across the block, so r24 is the only
# candidate; the right outcome is to leave the LD2 alone.
#
# Found in SpiderMonkey's SMRegExpMacroAssembler::ClearRegisters() built with
# -fprofile-use (the second run of the pass, before the second post-RA
# scheduler): an instruction field the regexp code generator encodes came
# out 0 instead of 20 and native regexps computed wrong results.  Disappears
# with -ia64-anti-dep-breaking=false.
#
# CHECK-LABEL: name: predicated_def
# CHECK:         $r24 = ADDL 20, $r0, $p6
# CHECK-NEXT:    $r14 = LD2 $r32, 0, $p0
# CHECK-NEXT:    ST2 $r33, $r14, 0, $p0
--- |
  define void @predicated_def(ptr %p, ptr %q) {
    ret void
  }
...
---
name: predicated_def
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r2, $r3, $r8, $r9, $r10, $r11, $r14, $r15, $r16, $r17, $r18, $r19, $r20, $r21, $r22, $r23, $r25, $r26, $r27, $r28, $r29, $r30, $r31, $r32, $r33, $r34, $b0

    $p6, $p7 = CMP_EQi 0, $r34, $p0
    ST2 $r33, $r14, 0, $p0
    $r24 = ADDL 20, $r0, $p6
    $r14 = LD2 $r32, 0, $p0
    ST2 $r33, $r14, 0, $p0
    $r24 = ADDS 0, $r0, $p7
    ST1 $r32, $r24, 0, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r2, implicit $r3, implicit $r8, implicit $r9, implicit $r10, implicit $r11, implicit $r15, implicit $r16, implicit $r17, implicit $r18, implicit $r19, implicit $r20, implicit $r21, implicit $r22, implicit $r23, implicit $r25, implicit $r26, implicit $r27, implicit $r28, implicit $r29, implicit $r30, implicit $r31
...
