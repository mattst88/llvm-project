# RUN: llc -mtriple=ia64 -run-pass=ia64-if-conversion -verify-machineinstrs \
# RUN:   -o - %s | FileCheck %s

# A register that is written and never read holds what it held before when
# the predicate is clear, and the other side reads that.

# CHECK-LABEL: name: dead_def
# CHECK:      $r17 = ADDS 0, $r15, $p0
# CHECK-NEXT: $p7, $p6 = CMP_EQ $r14, $r0, $p0
# CHECK-NEXT: {{^ *}}$r17 = LD2 $r0, 0, $p6, implicit $r17
# CHECK-NEXT: $r17 = ADDS 0, $r16, $p6, implicit $r17
# CHECK-NEXT: $r8 = ADDS 0, killed $r17, $p0

---
name: dead_def
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r14, $r15, $r16

    $r17 = ADDS 0, $r15, $p0
    BRCC %bb.1, 1, $r14, $r0, implicit-def dead $p6, implicit-def dead $p7
    BRUNCOND %bb.2

  bb.1:
    successors: %bb.2
    liveins: $r16

    dead $r17 = LD2 $r0, 0, $p0
    $r17 = ADDS 0, killed $r16, $p0

  bb.2:
    liveins: $r17

    $r8 = ADDS 0, killed $r17, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
