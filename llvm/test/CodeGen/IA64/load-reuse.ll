; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[J_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[C_PREV:%.*]] = phi double [ [[C_FIRST]], %[[ENTRY]] ], [ [[N:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[PE:%.*]] = getelementptr inbounds double, ptr [[EX]], i64 [[J]]
; CHECK-NEXT:    [[E:%.*]] = load double, ptr [[PE]], align 8
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[PN:%.*]] = getelementptr inbounds double, ptr [[HZ]], i64 [[J_NEXT]]
; CHECK-NEXT:    [[N]] = load double, ptr [[PN]], align 8
; CHECK-NEXT:    [[PC:%.*]] = getelementptr inbounds double, ptr [[HZ]], i64 [[J]]
; CHECK-NEXT:    [[D:%.*]] = fsub double [[N]], [[C_PREV]]
; CHECK-NEXT:    [[R:%.*]] = call double @llvm.fmuladd.f64(double [[D]], double -5.000000e-01, double [[E]])
; CHECK-NEXT:    store double [[R]], ptr [[PE]], align 8
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[J_NEXT]], 80
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop
loop:
  %j = phi i64 [ 0, %entry ], [ %j.next, %loop ]
  %pe = getelementptr inbounds double, ptr %ex, i64 %j
  %e = load double, ptr %pe
  %j.next = add nuw nsw i64 %j, 1
  %pn = getelementptr inbounds double, ptr %hz, i64 %j.next
  %n = load double, ptr %pn
  %pc = getelementptr inbounds double, ptr %hz, i64 %j
