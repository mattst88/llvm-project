; CHECK-NEXT:    [[PC:%.*]] = getelementptr inbounds i64, ptr [[X]], i64 [[J]]
; CHECK-NEXT:    [[PP:%.*]] = getelementptr inbounds i64, ptr [[X]], i64 [[J_PREV]]
; CHECK-NEXT:    [[P_PREV:%.*]] = load i64, ptr [[PP]], align 8
; CHECK-NEXT:    [[A:%.*]] = add i64 [[N]], [[C_PREV]]
