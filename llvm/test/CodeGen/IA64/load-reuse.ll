; CHECK-NEXT:    [[S:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[S_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[C_PREV:%.*]] = phi i64 [ [[C_FIRST]], %[[ENTRY]] ], [ [[N:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
; CHECK-NEXT:    [[J_PREV:%.*]] = add nsw i64 [[J]], -1
; CHECK-NEXT:    [[PN:%.*]] = getelementptr inbounds i64, ptr [[X]], i64 [[J_NEXT]]
