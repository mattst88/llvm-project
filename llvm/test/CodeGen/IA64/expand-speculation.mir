# RUN: llc -mtriple=ia64-unknown-linux-gnu -run-pass=ia64-expand-speculation \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# A pair whose register and address both survive to the check becomes
# ld4.sa and ld4.c.clr. Anything between them that writes the register, reads
# it, or writes the address undoes the pair: the speculative load becomes a
# move from r0 and the check becomes a plain load. The pseudos name the load
# by its opcode number, 723 for LD4, which changes when instructions are added.

# CHECK-LABEL: name: keep
# CHECK: $r15 = LD4_SA $r14, 0, $p0
# CHECK: $r15 = LD4_C_CLR killed $r14, 0, $p0, implicit $r15
# CHECK-NOT: {{SPEC|CHECK}}_LD
---
name:            keep
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r32, $r33, $r34, $r35
    $r16 = LD8 killed $r33, 0, $p0 :: (load (s64))
    $r14 = SHLADD $r16, 2, killed $r32, $p0
    $r15 = SPEC_LD_GR $r14, 723, 0 :: (load (s32))
    BRCC %bb.2, 7, killed $r16, killed $r35, implicit-def $p6, implicit-def $p7
  bb.1:
    liveins: $r14, $r15, $r34
    ST4 $r34, $r0, 0, $p0 :: (store (s32))
    $r15 = CHECK_LD_GR killed $r14, killed $r15, 723, 0 :: (load (s32))
    $r8 = ADDS 1, killed $r15, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8
  bb.2:
    $r8 = MOVL 4294967295, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8
...
# CHECK-LABEL: name: clobber_reg
# CHECK: $r15 = ADDS 0, $r0, $p0
# CHECK: $r15 = ADDS 1, $r34, $p0
# CHECK: $r15 = LD4 killed $r14, 0, $p0
---
name:            clobber_reg
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r32, $r33, $r34, $r35
    $r16 = LD8 killed $r33, 0, $p0 :: (load (s64))
    $r14 = SHLADD $r16, 2, killed $r32, $p0
    $r15 = SPEC_LD_GR $r14, 723, 0 :: (load (s32))
    BRCC %bb.2, 7, killed $r16, killed $r35, implicit-def $p6, implicit-def $p7
  bb.1:
    liveins: $r14, $r15, $r34
    ST4 $r34, $r0, 0, $p0 :: (store (s32))
    $r15 = ADDS 1, $r34, $p0
    $r15 = CHECK_LD_GR killed $r14, killed $r15, 723, 0 :: (load (s32))
    $r8 = ADDS 1, killed $r15, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8
  bb.2:
    $r8 = MOVL 4294967295, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8
...
# CHECK-LABEL: name: read_reg
# CHECK: $r15 = ADDS 0, $r0, $p0
# CHECK: $r34 = ADDS 1, $r15, $p0
# CHECK: $r15 = LD4 killed $r14, 0, $p0
---
name:            read_reg
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r32, $r33, $r34, $r35
    $r16 = LD8 killed $r33, 0, $p0 :: (load (s64))
    $r14 = SHLADD $r16, 2, killed $r32, $p0
    $r15 = SPEC_LD_GR $r14, 723, 0 :: (load (s32))
    BRCC %bb.2, 7, killed $r16, killed $r35, implicit-def $p6, implicit-def $p7
  bb.1:
    liveins: $r14, $r15, $r34
    ST4 $r34, $r0, 0, $p0 :: (store (s32))
    $r34 = ADDS 1, $r15, $p0
    $r15 = CHECK_LD_GR killed $r14, killed $r15, 723, 0 :: (load (s32))
    $r8 = ADDS 1, killed $r15, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8
  bb.2:
    $r8 = MOVL 4294967295, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8
...
# CHECK-LABEL: name: clobber_addr
# CHECK: $r15 = ADDS 0, $r0, $p0
# CHECK: $r14 = ADDS 8, $r14, $p0
# CHECK: $r15 = LD4 killed $r14, 0, $p0
---
name:            clobber_addr
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r32, $r33, $r34, $r35
    $r16 = LD8 killed $r33, 0, $p0 :: (load (s64))
    $r14 = SHLADD $r16, 2, killed $r32, $p0
    $r15 = SPEC_LD_GR $r14, 723, 0 :: (load (s32))
    BRCC %bb.2, 7, killed $r16, killed $r35, implicit-def $p6, implicit-def $p7
  bb.1:
    liveins: $r14, $r15, $r34
    ST4 $r34, $r0, 0, $p0 :: (store (s32))
    $r14 = ADDS 8, $r14, $p0
    $r15 = CHECK_LD_GR killed $r14, killed $r15, 723, 0 :: (load (s32))
    $r8 = ADDS 1, killed $r15, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8
  bb.2:
    $r8 = MOVL 4294967295, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8
...
# A block whose predecessors each issue the early load keeps the pair when
# every one of them wrote the register from the address the check reads.
# CHECK-LABEL: name: join
# CHECK: $r15 = LD4_SA $r14, 0, $p0
# CHECK: $r15 = LD4_SA $r14, 0, $p0
# CHECK: $r15 = LD4_C_CLR killed $r14, 0, $p0, implicit $r15
---
name:            join
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r32, $r33, $r34, $r35
    BRCC %bb.2, 7, $r33, $r35, implicit-def $p6, implicit-def $p7
  bb.1:
    successors: %bb.3
    liveins: $r32, $r33, $r34
    $r14 = SHLADD killed $r33, 2, killed $r32, $p0
    $r15 = SPEC_LD_GR $r14, 723, 0 :: (load (s32))
    BRUNCOND %bb.3
  bb.2:
    successors: %bb.3
    liveins: $r32, $r34, $r35
    $r14 = SHLADD killed $r35, 2, killed $r32, $p0
    $r15 = SPEC_LD_GR $r14, 723, 0 :: (load (s32))
  bb.3:
    liveins: $r14, $r15, $r34
    ST4 $r34, $r0, 0, $p0 :: (store (s32))
    $r15 = CHECK_LD_GR killed $r14, killed $r15, 723, 0 :: (load (s32))
    $r8 = ADDS 1, killed $r15, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8
...
# One predecessor that does not issue it, or issues it into another register,
# undoes the pair.
# CHECK-LABEL: name: join_missing
# CHECK: $r15 = ADDS 0, $r0, $p0
# CHECK: $r15 = LD4 killed $r14, 0, $p0
---
name:            join_missing
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r32, $r33, $r34, $r35
    BRCC %bb.2, 7, $r33, $r35, implicit-def $p6, implicit-def $p7
  bb.1:
    successors: %bb.3
    liveins: $r32, $r33, $r34
    $r14 = SHLADD killed $r33, 2, killed $r32, $p0
    $r15 = SPEC_LD_GR $r14, 723, 0 :: (load (s32))
    BRUNCOND %bb.3
  bb.2:
    successors: %bb.3
    liveins: $r32, $r34, $r35
    $r14 = SHLADD killed $r35, 2, killed $r32, $p0
  bb.3:
    liveins: $r14, $r15, $r34
    ST4 $r34, $r0, 0, $p0 :: (store (s32))
    $r15 = CHECK_LD_GR killed $r14, killed $r15, 723, 0 :: (load (s32))
    $r8 = ADDS 1, killed $r15, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8
...
# CHECK-LABEL: name: join_other_reg
# CHECK: $r15 = ADDS 0, $r0, $p0
# CHECK: $r16 = ADDS 0, $r0, $p0
# CHECK: $r15 = LD4 killed $r14, 0, $p0
---
name:            join_other_reg
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r32, $r33, $r34, $r35
    BRCC %bb.2, 7, $r33, $r35, implicit-def $p6, implicit-def $p7
  bb.1:
    successors: %bb.3
    liveins: $r32, $r33, $r34
    $r14 = SHLADD killed $r33, 2, killed $r32, $p0
    $r15 = SPEC_LD_GR $r14, 723, 0 :: (load (s32))
    BRUNCOND %bb.3
  bb.2:
    successors: %bb.3
    liveins: $r32, $r34, $r35
    $r14 = SHLADD killed $r35, 2, killed $r32, $p0
    $r16 = SPEC_LD_GR $r14, 723, 0 :: (load (s32))
    $r15 = COPY killed $r16
  bb.3:
    liveins: $r14, $r15, $r34
    ST4 $r34, $r0, 0, $p0 :: (store (s32))
    $r15 = CHECK_LD_GR killed $r14, killed $r15, 723, 0 :: (load (s32))
    $r8 = ADDS 1, killed $r15, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8
...
# A check in a loop whose next speculative load follows it in the same block
# keeps the pair: the path round the loop ends at that load.

# CHECK-LABEL: name: latch
# CHECK: $r15 = LD4_SA $r14, 0, $p0
# CHECK: $r15 = LD4_C_CLR killed $r14, 0, $p0, implicit $r15
# CHECK: $r15 = LD4_SA $r14, 0, $p0
# CHECK-NOT: {{SPEC|CHECK}}_LD
---
name:            latch
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r32, $r33
    $r14 = SHLADD killed $r33, 2, $r32, $p0
    $r15 = SPEC_LD_GR $r14, 723, 0 :: (load (s32))
  bb.1:
    successors: %bb.2, %bb.1
    liveins: $r14, $r15, $r32
    $r15 = CHECK_LD_GR killed $r14, killed $r15, 723, 0 :: (load (s32))
    $r16 = EXTR_U killed $r15, 8, 56, $p0
    $r14 = SHLADD $r16, 2, $r32, $p0
    $r15 = SPEC_LD_GR $r14, 723, 0 :: (load (s32))
    BRCCi %bb.2, 1, killed $r16, 0, implicit-def $p6, implicit-def $p7
    BRUNCOND %bb.1
  bb.2:
    BR_RET $b0, 0, 1, 0, $p0
...
# Without one, the path round the loop meets the check itself.

# CHECK-LABEL: name: latch_read
# CHECK: $r15 = ADDS 0, $r0, $p0
# CHECK: $r15 = LD4 $r14, 0, $p0
---
name:            latch_read
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1
    liveins: $r32, $r33
    $r14 = SHLADD killed $r33, 2, $r32, $p0
    $r15 = SPEC_LD_GR $r14, 723, 0 :: (load (s32))
  bb.1:
    successors: %bb.2, %bb.1
    liveins: $r14, $r15, $r32
    $r15 = CHECK_LD_GR $r14, killed $r15, 723, 0 :: (load (s32))
    $r16 = EXTR_U $r15, 8, 56, $p0
    BRCCi %bb.2, 1, killed $r16, 0, implicit-def $p6, implicit-def $p7
    BRUNCOND %bb.1
  bb.2:
    BR_RET $b0, 0, 1, 0, $p0
...
