# RUN: llc -mtriple=ia64-unknown-linux-gnu -start-before=ia64-insert-stops \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# A prefetch takes a load's port, not a store's, so it issues in one cycle
# with two stores and stays in the first group. Counted as a store too, it
# would be the third, and would move to the second group.

# CHECK-LABEL: prefetch:
# CHECK:       stfd [r32] = f8
# CHECK-NEXT:  stfd [r33] = f9
# CHECK-NEXT:  adds r14 = 1, r35
# CHECK-NEXT:  .mmi
# CHECK-NEXT:  lfetch [r34]
# CHECK-NEXT:  adds r15 = 1, r36
# CHECK-NEXT:  adds r16 = 1, r37 ;;
# CHECK-NEXT:  add r8 = r14, r15
# CHECK-NEXT:  adds r9 = 1, r16
# CHECK-NEXT:  br.ret.sptk.many b0 ;;
---
name: prefetch
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r32, $r33, $r34, $r35, $r36, $r37, $f8, $f9, $b0

    STFD killed $r32, killed $f8, 0, $p0 :: (store (s64))
    STFD killed $r33, killed $f9, 0, $p0 :: (store (s64))
    LFETCH killed $r34, 0, $p0 :: (load (s8))
    $r14 = ADDS 1, killed $r35, $p0
    $r15 = ADDS 1, killed $r36, $p0
    $r16 = ADDS 1, killed $r37, $p0
    $r8 = ADD killed $r14, killed $r15, $p0
    $r9 = ADDS 1, killed $r16, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8, implicit killed $r9
...
