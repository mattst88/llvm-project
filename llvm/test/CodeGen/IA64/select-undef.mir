# RUN: llc -mtriple=ia64 -run-pass=postrapseudos -verify-machineinstrs \
# RUN:   -o - %s | FileCheck %s

# The move that a select becomes keeps what its register held when the
# predicate is clear.  When that is no value at all, it is no use of one.

# CHECK-LABEL: name: integer
# CHECK:      $p6, $p7 = CMP_EQi 0, $r32, $p0
# CHECK-NEXT: $r8 = ADDS 0, $r33, $p6, implicit undef $r8

# CHECK-LABEL: name: floating
# CHECK:      $p6, $p7 = CMP_EQi 0, $r32, $p0
# CHECK-NEXT: $f8 = FMERGE_S $f9, $f9, $p6, implicit undef $f8

# CHECK-LABEL: name: defined
# CHECK:      $p6, $p7 = CMP_EQi 0, $r32, $p0
# CHECK-NEXT: $r8 = ADDS 0, $r33, $p6, implicit $r8

---
name: integer
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r32, $r33

    $r8 = SELECTi undef $r8, killed $r33, 0, killed $r32, 0, implicit-def dead $p6, implicit-def dead $p7
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
---
name: floating
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $f9, $r32

    $f8 = SELECT_FRi undef $f8, killed $f9, 0, killed $r32, 0, implicit-def dead $p6, implicit-def dead $p7
    BR_RET $b0, 0, 1, 0, $p0, implicit $f8
...
---
name: defined
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r8, $r32, $r33

    $r8 = SELECTi killed $r8, killed $r33, 0, killed $r32, 0, implicit-def dead $p6, implicit-def dead $p7
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
