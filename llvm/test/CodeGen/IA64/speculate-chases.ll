; CHECK:       loop.split:
; CHECK-NEXT:    [[NEXT]] = phi ptr [ [[NEXT2]], [[LOOP]] ], [ [[NEXT3]], [[LOOP_NAT]] ]
; CHECK-NEXT:    store ptr [[PREV]], ptr [[L]], align 8
; CHECK-NEXT:    [[END:%.*]] = icmp eq ptr [[NEXT]], null
