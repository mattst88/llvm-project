body:
  %next = load ptr, ptr %l, align 8
  %end = icmp eq ptr %next, null
  br i1 %end, label %return, label %loop

return:
  %r = phi ptr [ null, %entry ], [ %l, %loop ], [ null, %body ]
  ret ptr %r
}

; A store in the loop: not speculated.
define ptr @store(ptr %list, i16 %key) {
; CHECK-LABEL: @store(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[L:%.*]] = phi ptr [ [[NEXT:%.*]], [[BODY:%.*]] ], [ [[LIST:%.*]], [[ENTRY:%.*]] ]
; CHECK-NEXT:    [[INFOP:%.*]] = getelementptr inbounds nuw i8, ptr [[L]], i64 8
; CHECK-NEXT:    [[INFO:%.*]] = load ptr, ptr [[INFOP]], align 8
; CHECK-NEXT:    [[IDX:%.*]] = load i16, ptr [[INFO]], align 2
; CHECK-NEXT:    [[FOUND:%.*]] = icmp eq i16 [[IDX]], [[KEY:%.*]]
; CHECK-NEXT:    br i1 [[FOUND]], label [[RETURN:%.*]], label [[BODY]]
; CHECK:       body:
; CHECK-NEXT:    store i16 0, ptr [[INFO]], align 2
; CHECK-NEXT:    [[NEXT]] = load ptr, ptr [[L]], align 8
; CHECK-NEXT:    [[END:%.*]] = icmp eq ptr [[NEXT]], null
; CHECK-NEXT:    br i1 [[END]], label [[RETURN]], label [[LOOP]]
; CHECK:       return:
; CHECK-NEXT:    [[R:%.*]] = phi ptr [ [[L]], [[LOOP]] ], [ null, [[BODY]] ]
; CHECK-NEXT:    ret ptr [[R]]
;
entry:
  br label %loop

loop:
  %l = phi ptr [ %next, %body ], [ %list, %entry ]
  %infop = getelementptr inbounds nuw i8, ptr %l, i64 8
  %info = load ptr, ptr %infop, align 8
  %idx = load i16, ptr %info, align 2
  %found = icmp eq i16 %idx, %key
  br i1 %found, label %return, label %body

body:
  store i16 0, ptr %info, align 2
  %next = load ptr, ptr %l, align 8
  %end = icmp eq ptr %next, null
  br i1 %end, label %return, label %loop

return:
  %r = phi ptr [ %l, %loop ], [ null, %body ]
  ret ptr %r
}

; Only the next pointer is loaded: nothing to start early.
define ptr @last(ptr %list) {
; CHECK-LABEL: @last(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[L:%.*]] = phi ptr [ [[NEXT:%.*]], [[LOOP]] ], [ [[LIST:%.*]], [[ENTRY:%.*]] ]
; CHECK-NEXT:    [[NEXT]] = load ptr, ptr [[L]], align 8
; CHECK-NEXT:    [[END:%.*]] = icmp eq ptr [[NEXT]], null
; CHECK-NEXT:    br i1 [[END]], label [[RETURN:%.*]], label [[LOOP]]
; CHECK:       return:
; CHECK-NEXT:    ret ptr [[L]]
;
entry:
  br label %loop

loop:
  %l = phi ptr [ %next, %loop ], [ %list, %entry ]
  %next = load ptr, ptr %l, align 8
  %end = icmp eq ptr %next, null
  br i1 %end, label %return, label %loop

return:
  ret ptr %l
}

