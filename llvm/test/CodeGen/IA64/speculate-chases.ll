loop:
  %l = phi ptr [ %next, %loop ], [ %list, %entry ]
  %infop = getelementptr inbounds nuw i8, ptr %l, i64 8
  store ptr null, ptr %infop, align 8
  %next = load ptr, ptr %l, align 8
  %end = icmp eq ptr %next, null
  br i1 %end, label %return, label %loop

return:
  %r = phi ptr [ %l, %loop ]
  ret ptr %r
}

