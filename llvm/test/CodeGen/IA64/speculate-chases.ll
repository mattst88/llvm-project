; CHECK-NEXT:    [[NEXT1:%.*]] = inttoptr i64 [[NEXT_S1]] to ptr
; CHECK-NEXT:    br label [[LOOP_SPEC1:%.*]]
; CHECK:       loop.spec:
; CHECK-NEXT:    [[L_SPEC:%.*]] = phi ptr [ [[LIST]], [[LOOP_SPEC]] ], [ [[NEXT11:%.*]], [[LOOP_SPEC1]] ]
