# RUN: llc -mtriple=ia64 -run-pass=ia64-expand-branches -verify-machineinstrs \
# RUN:   -o - %s | FileCheck %s

# A branch that falls through to another does not lend it its predicates,
# and neither do predicates that are live there.

# CHECK-LABEL: name: live
# CHECK:      $p7, $p6 = CMP_EQi 0, $r14, $p0
# CHECK-NEXT: BR_COND %bb.3, {{.*}}, $p6
# CHECK:      $p10, $p11 = CMP_EQi 44, $r14, $p0
# CHECK-NEXT: BR_COND %bb.4, {{.*}}, $p10

---
name: live
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $r14, $p8

    BRCCi %bb.3, 1, $r14, 0, implicit-def dead $p6, implicit-def dead $p7

  bb.1:
    successors: %bb.4, %bb.2
    liveins: $r14, $p8

    BRCCi %bb.4, 0, $r14, 44, implicit-def dead $p6, implicit-def dead $p7

  bb.2:
    liveins: $p8

    $r8 = ADDS 1, $r0, $p8
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8

  bb.3:
    $r8 = ADDS 0, $r0, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8

  bb.4:
    $r8 = ADDS 2, $r0, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
