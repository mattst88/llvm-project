# RUN: llc -mtriple=ia64-unknown-linux-gnu -run-pass=ia64-speculate-loads \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Of the loads from near the same address in a block, only the first is
# issued early: if it misses, it brings in the line the others read. A load
# from 128 bytes further on may need a line of its own.

# CHECK-LABEL: name: one_per_line
# CHECK:      bb.0:
# CHECK:        [[P:%[0-9]+]]:gr = LD8
# CHECK-NEXT:   [[A128:%[0-9]+]]:gr = ADDS 128, [[P]]
# CHECK-NEXT:   SPEC_LD_GR [[A128]]
# CHECK-NEXT:   SPEC_LD_GR [[P]]
# CHECK:        BRCC %bb.1
# CHECK:      bb.1:
# CHECK:        ST4
# CHECK-NEXT:   CHECK_LD_GR [[P]],
# CHECK-NEXT:   [[A8:%[0-9]+]]:gr = ADDS 8, [[P]]
# CHECK-NEXT:   LD4 [[A8]], 0, $p0
# CHECK-NEXT:   CHECK_LD_GR [[A128]],
---
name:            one_per_line
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $r32, $r33, $r34
    %0:gr = COPY $r32
    %1:gr = COPY $r33
    %2:gr = COPY $r34
    %3:gr = LD8 %1, 0, $p0 :: (load (s64))
    BRCC %bb.1, 7, %1, %2, implicit-def dead $p6, implicit-def dead $p7
    BRUNCOND %bb.2
  bb.1:
    ST4 %0, $r0, 0, $p0 :: (store (s32))
    %4:gr = LD4 %3, 0, $p0 :: (load (s32))
    %5:gr = ADDS 8, %3, $p0
    %6:gr = LD4 %5, 0, $p0 :: (load (s32))
    %7:gr = ADDS 128, %3, $p0
    %8:gr = LD4 %7, 0, $p0 :: (load (s32))
    %9:gr = ADD %4, %6, $p0
    $r8 = ADD %9, %8, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
  bb.2:
    $r8 = MOVL 4294967295, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
