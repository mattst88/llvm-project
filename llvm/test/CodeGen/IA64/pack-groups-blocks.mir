# RUN: llc -mtriple=ia64-unknown-linux-gnu -start-before=ia64-insert-stops \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=ia64-unknown-linux-gnu -start-before=ia64-insert-stops \
# RUN:   -filetype=obj -o - %s | llvm-objdump -d --no-show-raw-insn - \
# RUN:   | FileCheck %s --check-prefix=OBJ

# An instruction group continues into the block a branch falls through to,
# so the packer must not move an instruction into a group that holds
# instructions of another block it does not see.

---
# The first group of bb.1 continues the one bb.0 ends with, which writes b0.
# CHECK-LABEL: open_before:
# CHECK:       mov b0 = r38
# CHECK:       // %bb.1:
# CHECK-NOT:   b0
# CHECK:       sub r15 = r34, r35 ;;
# CHECK:       mov b0 = r39
name: open_before
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $r32, $r33, $r34, $r35, $r37, $r38, $r39

    $b0 = MOV_BR $r38, 0, $p0
    $p6, $p7 = CMP_EQi 0, $r34, $p0
    BR_COND %bb.2, 3, 0, 0, $p6

  bb.1:
    liveins: $r32, $r33, $r34, $r35, $r37, $r39

    renamable $r14 = LD8 killed renamable $r32, 0, $p0
    renamable $r15 = SUB killed renamable $r34, killed renamable $r35, $p0
    $b0 = MOV_BR killed $r39, 0, $p0
    renamable $r14 = ADDS -8, killed renamable $r14, $p0
    renamable $r16 = LD8 killed renamable $r33, 0, $p0
    $ar64 = MOV_AR_RESTORE killed $r37, $p0
    renamable $r14 = LD8 killed renamable $r14, 0, $p0
    renamable $r15 = ADD killed renamable $r15, killed renamable $r16, $p0
    renamable $r8 = ADD killed renamable $r14, killed renamable $r15, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8

  bb.2:
    BR_RET $b0, 0, 1, 0, $p0
...
---
# The last group of bb.0 continues into bb.1, which writes b0 first.
# CHECK-LABEL: open_after:
# CHECK:       mov b0 = r38
# CHECK:       mov ar.pfs = r37 ;;
# CHECK-NOT:   b0
# CHECK:       // %bb.1:
# CHECK-NEXT:  mov b0 = r36 ;;
name: open_after
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r32, $r33, $r36, $r37, $r38

    renamable $r14 = LD8 killed renamable $r32, 0, $p0
    $b0 = MOV_BR killed $r38, 0, $p0
    $ar64 = MOV_AR_RESTORE killed $r37, $p0
    renamable $r14 = ADDS -8, killed renamable $r14, $p0

  bb.1:
    liveins: $r14, $r33, $r36

    $b0 = MOV_BR killed $r36, 0, $p0
    renamable $r8 = ADD killed renamable $r14, killed renamable $r33, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit killed $r8
...
---
# bb.0's last group, the compare and the branch, continues into bb.1, which
# starts a bundle. Packed after the stop in the bundle before, the group
# would take two bundles, and bb.1's first would wait for the next cycle.
# OBJ-LABEL: <open_end>:
# OBJ:       mov r8 = -4 ;;
# OBJ-NEXT:  cmp4.lt p6, p7 = r14, r15 // [MIB]
name: open_end
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $r32, $r33

    $r48 = ADDL -1, $r0, $p0
    $r15 = ADDL 1, $r0, $p0
    $r14 = ADDL 2097151, $r0, $p0
    $r8 = ADDL -4, $r0, $p0
    $p6, $p7 = CMP4_LT $r14, $r15, $p0
    BR_COND %bb.2, 3, 0, 0, $p6

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $r8, $r15, $r32, $r33, $r48

    $r47 = DEP_Zi 1, 1, 63, $p0
    $r16 = ADD $r47, $r48, $p0
    $r48 = ADD $r16, $r32, $p0
    $p6, $p7 = CMP4_LT $r48, $r33, $p0
    BR_COND %bb.1, 3, 0, 0, $p6

  bb.2:
    liveins: $r8

    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
---
# bb.1's first group, the mov alone, continues the group bb.0 ends with.
# It moves into the group of the call, and bb.0's group ends at its branch
# instead.
# CHECK-LABEL: open_empties:
# CHECK:       (p6) br.cond.dptk.few .LBB3_2 ;;
# CHECK:       mov r33 = r1{{$}}
# CHECK-NEXT:  br.call.sptk.many b0 = f ;;
name: open_empties
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $r1, $r32, $b0

    $r34 = ALLOC 1, 3, 0, 0, $p0, implicit $ar64
    $r35 = MOV_FROM_BR $b0, $p0
    $p7, $p6 = TBIT_Z $r32, 3, $p0
    BR_COND %bb.2, 2, 0, 0, $p6

  bb.1:
    liveins: $r1, $r34, $r35

    $r33 = ADDS 0, $r1, $p0
    $b0 = BR_CALL &f, 0, 1, 0, $p0, csr_ia64_call, implicit-def $ar64, implicit-def dead $r1, implicit-def $r12
    $b0 = MOV_BR killed $r35, 0, $p0
    $r1 = ADDS 0, killed $r33, $p0
    $ar64 = MOV_AR_RESTORE killed $r34, $p0
    BR_RET $b0, 0, 1, 0, $p0

  bb.2:
    BR_RET $b0, 0, 1, 0, $p0
...
