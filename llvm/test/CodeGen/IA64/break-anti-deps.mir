# RUN: llc -mtriple=ia64-unknown-linux-gnu -run-pass=ia64-break-anti-deps \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

# The second address reuses r14 after the first load reads it, so it could
# not be computed in the same group. It moves to a scratch register the
# block does not use, and the load that reads it follows.
# CHECK-LABEL: name: reuse
# CHECK:         $r14 = ADDS 8, $r32, $p0
# CHECK-NEXT:    $r16 = LD8 $r14, 0, $p0
# CHECK-NEXT:    $[[R:r[0-9]+]] = ADDS 16, $r32, $p0
# CHECK-NEXT:    $r17 = LD8 $[[R]], 0, $p0
# CHECK-NEXT:    $r8 = ADD $r16, $r17, $p0
---
name: reuse
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r32

    $r14 = ADDS 8, $r32, $p0
    $r16 = LD8 $r14, 0, $p0
    $r14 = ADDS 16, $r32, $p0
    $r17 = LD8 $r14, 0, $p0
    $r8 = ADD $r16, $r17, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
---
# The value is read after a call, which clobbers every scratch register.
# That the call clobbers r17 is no reason to move the load after it.
# CHECK-LABEL: name: across_call
# CHECK:         $r35 = ADDS 16, $r32, $p0
# CHECK:         $r17 = LD8 $r35, 0, $p0
name: across_call
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r32, $b6

    $r35 = ADDS 8, $r32, $p0
    $r36 = LD8 $r35, 0, $p0
    $r35 = ADDS 16, $r32, $p0
    $b0 = BR_CALL_B $b6, 0, 1, 0, $p0, csr_ia64_call, implicit-def $ar64
    $r17 = LD8 $r35, 0, $p0
    $r8 = ADD $r36, $r17, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
---
# The immediate form of addl reads only r0 to r3, and the others of those
# are reserved, so the value stays.
# CHECK-LABEL: name: operand_class
# CHECK:         $r3 = ADDS 0, $r33, $p0
# CHECK-NEXT:    $r9 = ADDL 6, $r3, $p0
name: operand_class
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r32, $r33

    $r3 = ADDS 0, $r32, $p0
    $r8 = ADDL 5, $r3, $p0
    $r3 = ADDS 0, $r33, $p0
    $r9 = ADDL 6, $r3, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8, implicit $r9
...
---
# The second write already waits for the load through what it reads, so
# moving it gains nothing.
# CHECK-LABEL: name: chain
# CHECK:         $r14 = ADDS 1, $r16, $p0
# CHECK-NEXT:    $r17 = LD8 $r14, 0, $p0
name: chain
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r32

    $r14 = ADDS 8, $r32, $p0
    $r16 = LD8 $r14, 0, $p0
    $r14 = ADDS 1, $r16, $p0
    $r17 = LD8 $r14, 0, $p0
    $r8 = ADD $r16, $r17, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
---
# The block leaves the value in r14 for its successor.
# CHECK-LABEL: name: live_out
# CHECK:         $r14 = ADDS 16, $r32, $p0
# CHECK-NEXT:    $r17 = LD8 $r14, 0, $p0
name: live_out
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $r32

    $r14 = ADDS 8, $r32, $p0
    $r16 = LD8 $r14, 0, $p0
    $r14 = ADDS 16, $r32, $p0
    $r17 = LD8 $r14, 0, $p0

  bb.1:
    liveins: $r14, $r16, $r17

    $r8 = ADD $r16, $r17, $p0
    $r8 = ADD $r8, $r14, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
---
# A write under a predicate moves along with its reads under the same one,
# here through a write of the register that reads it, which moves too.
# CHECK-LABEL: name: predicated
# CHECK:         $r16 = LD8 $r14, 0, $p16
# CHECK-NEXT:    $r15 = ADDS 16, $r33, $p17
# CHECK-NEXT:    $r18 = ZXT4 $r15, $p17
# CHECK-NEXT:    $r17 = LD8 $r18, 0, $p17
name: predicated
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r32, $r33, $p16, $p17

    $r14 = ADDS 8, $r32, $p16
    $r16 = LD8 $r14, 0, $p16
    $r14 = ADDS 16, $r33, $p17
    $r14 = ZXT4 $r14, $p17
    $r17 = LD8 $r14, 0, $p17
    $r8 = ADD $r16, $r17, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
---
# A read under another predicate may see the value from before the write.
# CHECK-LABEL: name: other_predicate
# CHECK:         $r14 = ADDS 16, $r33, $p17
# CHECK-NEXT:    $r17 = LD8 $r14, 0, $p16
name: other_predicate
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r32, $r33, $p16, $p17

    $r14 = ADDS 8, $r32, $p16
    $r16 = LD8 $r14, 0, $p16
    $r14 = ADDS 16, $r33, $p17
    $r17 = LD8 $r14, 0, $p16
    $r8 = ADD $r16, $r17, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
---
# The read is under the predicate the compare writes, not the one the
# write was under.
# CHECK-LABEL: name: predicate_changes
# CHECK:         $r14 = ADDS 16, $r33, $p17
# CHECK-NEXT:    $p17, $p18 = CMP_EQ $r32, $r33, $p0
# CHECK-NEXT:    $r17 = LD8 $r14, 0, $p17
name: predicate_changes
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r32, $r33, $p16, $p17

    $r14 = ADDS 8, $r32, $p16
    $r16 = LD8 $r14, 0, $p16
    $r14 = ADDS 16, $r33, $p17
    $p17, $p18 = CMP_EQ $r32, $r33, $p0
    $r17 = LD8 $r14, 0, $p17
    $r8 = ADD $r16, $r17, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
---
# The load of the next pointer is left in r15 for the successor, so it
# stays; the chain that held r15 before it, read only in the block, moves
# out of its way instead, one value at a time back from the load.
# CHECK-LABEL: name: earlier_values
# CHECK:         $r17 = ADDS 8, $r32, $p0
# CHECK-NEXT:    $r16 = LD8 $r17, 0, $p0
# CHECK-NEXT:    $r14 = ADDS 2, $r16, $p0
# CHECK-NEXT:    $r19 = LD2 $r14, 0, $p0
# CHECK-NEXT:    $r15 = LD8 $r8, 0, $p0
name: earlier_values
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r8, $r32

    $r15 = ADDS 8, $r32, $p0
    $r15 = LD8 $r15, 0, $p0
    $r15 = ADDS 2, $r15, $p0
    $r19 = LD2 $r15, 0, $p0
    $r15 = LD8 $r8, 0, $p0
    BR_RET $b0, 0, 1, 0, $p0, implicit $r15, implicit $r19
...
---
# A floating-point value moves the same way: the second product could not be
# computed in the group of the first add, which reads the first.
# CHECK-LABEL: name: fp_reuse
# CHECK:         $f6 = FMA_D $f8, $f9, $f0, 0, $p0
# CHECK-NEXT:    $f10 = FMA_D $f6, $f1, $f8, 0, $p0
# CHECK-NEXT:    $[[F:f[0-9]+]] = FMA_D $f9, $f9, $f0, 0, $p0
# CHECK-NEXT:    $f8 = FMA_D $[[F]], $f1, $f10, 0, $p0
name: fp_reuse
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $f8, $f9

    $f6 = FMA_D $f8, $f9, $f0, 0, $p0, implicit $ar40
    $f10 = FMA_D $f6, $f1, $f8, 0, $p0, implicit $ar40
    $f6 = FMA_D $f9, $f9, $f0, 0, $p0, implicit $ar40
    $f8 = FMA_D $f6, $f1, $f10, 0, $p0, implicit $ar40
    BR_RET $b0, 0, 1, 0, $p0, implicit $f8
...
---
# A kernel's floating-point registers rotate, so they stay put.
# CHECK-LABEL: name: fp_kernel
# CHECK:         $f6 = FMA_D $f8, $f9, $f0, 0, $p0
# CHECK-NEXT:    $f10 = FMA_D $f6, $f1, $f8, 0, $p0
# CHECK-NEXT:    $f6 = FMA_D $f9, $f9, $f0, 0, $p0
# CHECK-NEXT:    $f8 = FMA_D $f6, $f1, $f10, 0, $p0
name: fp_kernel
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $f8, $f9

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $f8, $f9

    $f6 = FMA_D $f8, $f9, $f0, 0, $p0, implicit $ar40
    $f10 = FMA_D $f6, $f1, $f8, 0, $p0, implicit $ar40
    $f6 = FMA_D $f9, $f9, $f0, 0, $p0, implicit $ar40
    $f8 = FMA_D $f6, $f1, $f10, 0, $p0, implicit $ar40
    BR_CTOP %bb.1, 0, 0, 0, implicit-def $ar65, implicit-def $ar66, implicit $ar65, implicit $ar66

  bb.2:
    liveins: $f8

    BR_RET $b0, 0, 1, 0, $p0, implicit $f8
...
