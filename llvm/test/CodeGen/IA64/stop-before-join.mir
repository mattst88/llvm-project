# RUN: llc -mtriple=ia64-unknown-linux-gnu -start-before=ia64-insert-stops \
# RUN:   -verify-machineinstrs -ia64-packing=false -o - %s | FileCheck %s
# RUN: llc -mtriple=ia64-unknown-linux-gnu -start-before=ia64-insert-stops \
# RUN:   -verify-machineinstrs -ia64-packing=false -ia64-stop-before-join=false \
# RUN:   -o - %s | FileCheck %s --check-prefix=OFF

# The group of the loop's entry would go on into the loop, and the add that
# reads r14 would end it there, in every iteration. A stop before the loop
# ends it instead, and the iteration takes one group fewer.
# CHECK-LABEL: loop:
# CHECK:       (p6) br.cond.dpnt.many .LBB0_2 ;;
# CHECK-NEXT:  .LBB0_1:
# CHECK-NEXT:  ld8 r16 = [r15]
# CHECK-NEXT:  adds r15 = 8, r15
# CHECK-NEXT:  add r17 = r14, r33 ;;
# CHECK-NEXT:  add r18 = r16, r17 ;;
# OFF-LABEL:   loop:
# OFF:         (p6) br.cond.dpnt.many .LBB0_2{{$}}
# OFF-NEXT:    .LBB0_1:
# OFF-NEXT:    ld8 r16 = [r15]
# OFF-NEXT:    adds r15 = 8, r15 ;;
# OFF-NEXT:    add r17 = r14, r33 ;;
---
name: loop
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)
    liveins: $r15, $r32, $r33

    $p6, $p7 = CMP4_LT $r32, $r33, $p0
    $r14 = ADDS 1, $r33, $p0
    BR_COND %bb.2, 3, 0, 0, $p6

  bb.1:
    successors: %bb.1(0x7c000000), %bb.2(0x04000000)
    liveins: $r14, $r15, $r33

    $r16 = LD8 $r15, 0, $p0
    $r15 = ADDS 8, $r15, $p0
    $r17 = ADD $r14, $r33, $p0
    $r18 = ADD $r16, $r17, $p0
    $p6, $p7 = CMP4_LT $r18, $r33, $p0
    BR_COND %bb.1, 3, 0, 0, $p6

  bb.2:
    BR_RET $b0, 0, 1, 0, $p0
...
