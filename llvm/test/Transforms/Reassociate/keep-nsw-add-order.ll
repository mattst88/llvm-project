; RUN: opt < %s -passes=reassociate -S | FileCheck %s

; Sorting these leaves, all from the root's block, would only drop nsw.
define i32 @same_block(ptr %p0, ptr %p1, ptr %p2) {
; CHECK-LABEL: define i32 @same_block(
; CHECK-SAME: ptr [[P0:%.*]], ptr [[P1:%.*]], ptr [[P2:%.*]]) {
; CHECK-NEXT:    [[V0:%.*]] = load i32, ptr [[P0]], align 4
; CHECK-NEXT:    [[V1:%.*]] = load i32, ptr [[P1]], align 4
; CHECK-NEXT:    [[V2:%.*]] = load i32, ptr [[P2]], align 4
; CHECK-NEXT:    [[ADD0:%.*]] = add nsw i32 [[V1]], [[V2]]
; CHECK-NEXT:    [[ADD1:%.*]] = add nsw i32 [[V0]], [[ADD0]]
; CHECK-NEXT:    ret i32 [[ADD1]]
;
  %v0 = load i32, ptr %p0, align 4
  %v1 = load i32, ptr %p1, align 4
  %v2 = load i32, ptr %p2, align 4
  %add0 = add nsw i32 %v1, %v2
  %add1 = add nsw i32 %v0, %add0
  ret i32 %add1
}

; The root is only sign-extended: LICM reassociates it in the wide type.
define i64 @sext_only(i32 %inv, ptr %p, i32 %n) {
; CHECK-LABEL: define i64 @sext_only(
; CHECK-SAME: i32 [[INV:%.*]], ptr [[P:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[P]], align 4
; CHECK-NEXT:    [[ADD0:%.*]] = add nsw i32 [[I]], [[V]]
; CHECK-NEXT:    [[ADD1:%.*]] = add nsw i32 [[INV]], [[ADD0]]
; CHECK-NEXT:    [[EXT:%.*]] = sext i32 [[ADD1]] to i64
; CHECK-NEXT:    [[I_NEXT]] = add nsw i32 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp slt i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i64 [[EXT]]
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %v = load i32, ptr %p, align 4
  %add0 = add nsw i32 %v, %i
  %add1 = add nsw i32 %add0, %inv
  %ext = sext i32 %add1 to i64
  %i.next = add nsw i32 %i, 1
  %c = icmp slt i32 %i.next, %n
  br i1 %c, label %loop, label %exit

exit:
  ret i64 %ext
}

