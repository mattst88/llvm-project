; Constant leaves fold, a real rewrite.
define i32 @constant_leaf(ptr %p0, ptr %p1) {
; CHECK-LABEL: define i32 @constant_leaf(
; CHECK-SAME: ptr [[P0:%.*]], ptr [[P1:%.*]]) {
; CHECK-NEXT:    [[V0:%.*]] = load i32, ptr [[P0]], align 4
; CHECK-NEXT:    [[V1:%.*]] = load i32, ptr [[P1]], align 4
; CHECK-NEXT:    [[ADD1:%.*]] = add i32 [[V0]], 3
; CHECK-NEXT:    [[ADD2:%.*]] = add i32 [[ADD1]], [[V1]]
; CHECK-NEXT:    ret i32 [[ADD2]]
;
  %v0 = load i32, ptr %p0, align 4
  %v1 = load i32, ptr %p1, align 4
  %add0 = add nsw i32 %v0, 1
  %add1 = add nsw i32 %add0, %v1
  %add2 = add nsw i32 %add1, 2
  ret i32 %add2
}

; A repeated leaf becomes a multiply.
define i32 @repeated_leaf(ptr %p0, ptr %p1) {
; CHECK-LABEL: define i32 @repeated_leaf(
; CHECK-SAME: ptr [[P0:%.*]], ptr [[P1:%.*]]) {
; CHECK-NEXT:    [[V0:%.*]] = load i32, ptr [[P0]], align 4
; CHECK-NEXT:    [[V1:%.*]] = load i32, ptr [[P1]], align 4
; CHECK-NEXT:    [[FACTOR:%.*]] = mul i32 [[V0]], 2
; CHECK-NEXT:    [[ADD1:%.*]] = add i32 [[FACTOR]], [[V1]]
; CHECK-NEXT:    ret i32 [[ADD1]]
;
  %v0 = load i32, ptr %p0, align 4
  %v1 = load i32, ptr %p1, align 4
  %add0 = add nsw i32 %v0, %v1
  %add1 = add nsw i32 %add0, %v0
  ret i32 %add1
}
