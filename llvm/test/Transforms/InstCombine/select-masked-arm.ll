; When the condition says that X has no bits outside M, the arm X is equal to
; the arm (and X, M), and the select is the latter.

define i32 @shift_of_nonnegative(i32 %x) {
; CHECK-LABEL: @shift_of_nonnegative(
; CHECK-NEXT:    [[S:%.*]] = lshr i32 [[X:%.*]], 23
; CHECK-NEXT:    [[A:%.*]] = and i32 [[S]], 255
; CHECK-NEXT:    ret i32 [[A]]
;
  %s = lshr i32 %x, 23
  %c = icmp sgt i32 %x, -1
  %a = and i32 %s, 255
  %r = select i1 %c, i32 %s, i32 %a
  ret i32 %r
}

define i32 @shift_of_nonnegative_false_arm(i32 %x) {
; CHECK-LABEL: @shift_of_nonnegative_false_arm(
; CHECK-NEXT:    [[S:%.*]] = lshr i32 [[X:%.*]], 23
; CHECK-NEXT:    [[A:%.*]] = and i32 [[S]], 255
; CHECK-NEXT:    ret i32 [[A]]
;
  %s = lshr i32 %x, 23
  %c = icmp slt i32 %x, 0
  %a = and i32 %s, 255
  %r = select i1 %c, i32 %a, i32 %s
  ret i32 %r
}

