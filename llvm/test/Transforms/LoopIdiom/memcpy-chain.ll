define void @atomic_load(ptr noalias %d, ptr noalias %s, i64 %n) {
; CHECK-LABEL: define void @atomic_load(
; CHECK-SAME: ptr noalias [[D:%.*]], ptr noalias [[S:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[OFF:%.*]] = shl nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[SP:%.*]] = getelementptr inbounds i8, ptr [[S]], i64 [[OFF]]
; CHECK-NEXT:    [[DP:%.*]] = getelementptr inbounds i8, ptr [[D]], i64 [[OFF]]
; CHECK-NEXT:    [[V0:%.*]] = load atomic i8, ptr [[SP]] unordered, align 1
; CHECK-NEXT:    store i8 [[V0]], ptr [[DP]], align 1
; CHECK-NEXT:    [[S1:%.*]] = getelementptr inbounds i8, ptr [[SP]], i64 1
; CHECK-NEXT:    [[V1:%.*]] = load i8, ptr [[S1]], align 1
; CHECK-NEXT:    [[D1:%.*]] = getelementptr inbounds i8, ptr [[DP]], i64 1
; CHECK-NEXT:    store i8 [[V1]], ptr [[D1]], align 1
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %off = shl nuw nsw i64 %i, 1
  %sp = getelementptr inbounds i8, ptr %s, i64 %off
  %dp = getelementptr inbounds i8, ptr %d, i64 %off
  %v0 = load atomic i8, ptr %sp unordered, align 1
  store i8 %v0, ptr %dp, align 1
  %s1 = getelementptr inbounds i8, ptr %sp, i64 1
  %v1 = load i8, ptr %s1, align 1
  %d1 = getelementptr inbounds i8, ptr %dp, i64 1
  store i8 %v1, ptr %d1, align 1
  %i.next = add nuw nsw i64 %i, 1
  %cmp = icmp ult i64 %i.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

; Another store in the loop writes the source.
define void @source_clobbered(ptr noalias %d, ptr noalias %s, i64 %n) {
; CHECK-LABEL: define void @source_clobbered(
; CHECK-SAME: ptr noalias [[D:%.*]], ptr noalias [[S:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[OFF:%.*]] = shl nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[SP:%.*]] = getelementptr inbounds i8, ptr [[S]], i64 [[OFF]]
; CHECK-NEXT:    [[DP:%.*]] = getelementptr inbounds i8, ptr [[D]], i64 [[OFF]]
; CHECK-NEXT:    [[V0:%.*]] = load i8, ptr [[SP]], align 1
; CHECK-NEXT:    store i8 [[V0]], ptr [[DP]], align 1
; CHECK-NEXT:    [[S1:%.*]] = getelementptr inbounds i8, ptr [[SP]], i64 1
; CHECK-NEXT:    [[V1:%.*]] = load i8, ptr [[S1]], align 1
; CHECK-NEXT:    [[D1:%.*]] = getelementptr inbounds i8, ptr [[DP]], i64 1
; CHECK-NEXT:    store i8 [[V1]], ptr [[D1]], align 1
; CHECK-NEXT:    [[S3:%.*]] = getelementptr inbounds i8, ptr [[SP]], i64 3
; CHECK-NEXT:    store i8 0, ptr [[S3]], align 1
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %off = shl nuw nsw i64 %i, 1
  %sp = getelementptr inbounds i8, ptr %s, i64 %off
  %dp = getelementptr inbounds i8, ptr %d, i64 %off
  %v0 = load i8, ptr %sp, align 1
  store i8 %v0, ptr %dp, align 1
  %s1 = getelementptr inbounds i8, ptr %sp, i64 1
  %v1 = load i8, ptr %s1, align 1
  %d1 = getelementptr inbounds i8, ptr %dp, i64 1
  store i8 %v1, ptr %d1, align 1
  %s3 = getelementptr inbounds i8, ptr %sp, i64 3
  store i8 0, ptr %s3, align 1
  %i.next = add nuw nsw i64 %i, 1
  %cmp = icmp ult i64 %i.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}
