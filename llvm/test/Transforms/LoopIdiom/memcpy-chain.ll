define void @move_down_pairs(ptr %p, i64 %n) {
; CHECK-LABEL: define void @move_down_pairs(
; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
