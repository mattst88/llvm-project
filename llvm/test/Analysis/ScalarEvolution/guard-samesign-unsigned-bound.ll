; A samesign unsigned lower bound of zero or more is a signed one too, so the
; sign-extended bound needs no smax.

define void @samesign_ugt(ptr %p, i32 %n) {
; CHECK-LABEL: 'samesign_ugt'
; CHECK-NEXT:  Determining loop execution counts for: @samesign_ugt
; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (sext i32 %n to i64))<nsw>
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 2147483646
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (sext i32 %n to i64))<nsw>
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %guard = icmp samesign ugt i32 %n, 1
  br i1 %guard, label %loop.ph, label %exit

loop.ph:
  %n.ext = sext i32 %n to i64
  br label %loop

loop:
  %iv = phi i64 [ 0, %loop.ph ], [ %iv.next, %loop ]
  %gep = getelementptr inbounds i8, ptr %p, i64 %iv
  store i8 0, ptr %gep
  %iv.next = add nsw i64 %iv, 1
  %cmp = icmp slt i64 %iv.next, %n.ext
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

