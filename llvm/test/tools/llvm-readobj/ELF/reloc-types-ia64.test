--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_IA_64
  Flags:   [ EF_IA_64_ABI64 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
  - Name: .rela.text
    Type: SHT_RELA
    Link: .symtab
    Info: .text
    Relocations:
      - Type: R_IA64_NONE
      - Type: R_IA64_IMM14
      - Type: R_IA64_IMM22
