## Test that llvm-readobj/llvm-readelf shows proper relocation type
## names and values for the ia64 target.

# RUN: yaml2obj %s -o %t-ia64.o
# RUN: llvm-readobj -r --expand-relocs %t-ia64.o | FileCheck %s

# CHECK: Type: R_IA64_NONE (0)
# CHECK: Type: R_IA64_IMM14 (33)
# CHECK: Type: R_IA64_IMM22 (34)
# CHECK: Type: R_IA64_IMM64 (35)
# CHECK: Type: R_IA64_DIR32MSB (36)
# CHECK: Type: R_IA64_DIR32LSB (37)
# CHECK: Type: R_IA64_DIR64MSB (38)
# CHECK: Type: R_IA64_DIR64LSB (39)
# CHECK: Type: R_IA64_GPREL22 (42)
# CHECK: Type: R_IA64_GPREL64I (43)
# CHECK: Type: R_IA64_GPREL32MSB (44)
# CHECK: Type: R_IA64_GPREL32LSB (45)
# CHECK: Type: R_IA64_GPREL64MSB (46)
# CHECK: Type: R_IA64_GPREL64LSB (47)
# CHECK: Type: R_IA64_LTOFF22 (50)
# CHECK: Type: R_IA64_LTOFF64I (51)
# CHECK: Type: R_IA64_PLTOFF22 (58)
# CHECK: Type: R_IA64_PLTOFF64I (59)
# CHECK: Type: R_IA64_PLTOFF64MSB (62)
# CHECK: Type: R_IA64_PLTOFF64LSB (63)
# CHECK: Type: R_IA64_FPTR64I (67)
# CHECK: Type: R_IA64_FPTR32MSB (68)
# CHECK: Type: R_IA64_FPTR32LSB (69)
# CHECK: Type: R_IA64_FPTR64MSB (70)
# CHECK: Type: R_IA64_FPTR64LSB (71)
# CHECK: Type: R_IA64_PCREL60B (72)
# CHECK: Type: R_IA64_PCREL21B (73)
# CHECK: Type: R_IA64_PCREL21M (74)
# CHECK: Type: R_IA64_PCREL21F (75)
# CHECK: Type: R_IA64_PCREL32MSB (76)
# CHECK: Type: R_IA64_PCREL32LSB (77)
# CHECK: Type: R_IA64_PCREL64MSB (78)
# CHECK: Type: R_IA64_PCREL64LSB (79)
# CHECK: Type: R_IA64_LTOFF_FPTR22 (82)
# CHECK: Type: R_IA64_LTOFF_FPTR64I (83)
# CHECK: Type: R_IA64_LTOFF_FPTR32MSB (84)
# CHECK: Type: R_IA64_LTOFF_FPTR32LSB (85)
# CHECK: Type: R_IA64_LTOFF_FPTR64MSB (86)
# CHECK: Type: R_IA64_LTOFF_FPTR64LSB (87)
# CHECK: Type: R_IA64_SEGREL32MSB (92)
# CHECK: Type: R_IA64_SEGREL32LSB (93)
# CHECK: Type: R_IA64_SEGREL64MSB (94)
# CHECK: Type: R_IA64_SEGREL64LSB (95)
# CHECK: Type: R_IA64_SECREL32MSB (100)
# CHECK: Type: R_IA64_SECREL32LSB (101)
# CHECK: Type: R_IA64_SECREL64MSB (102)
# CHECK: Type: R_IA64_SECREL64LSB (103)
# CHECK: Type: R_IA64_REL32MSB (108)
# CHECK: Type: R_IA64_REL32LSB (109)
# CHECK: Type: R_IA64_REL64MSB (110)
# CHECK: Type: R_IA64_REL64LSB (111)
# CHECK: Type: R_IA64_LTV32MSB (116)
# CHECK: Type: R_IA64_LTV32LSB (117)
# CHECK: Type: R_IA64_LTV64MSB (118)
# CHECK: Type: R_IA64_LTV64LSB (119)
# CHECK: Type: R_IA64_PCREL21BI (121)
# CHECK: Type: R_IA64_PCREL22 (122)
# CHECK: Type: R_IA64_PCREL64I (123)
# CHECK: Type: R_IA64_IPLTMSB (128)
# CHECK: Type: R_IA64_IPLTLSB (129)
# CHECK: Type: R_IA64_COPY (132)
# CHECK: Type: R_IA64_SUB (133)
# CHECK: Type: R_IA64_LTOFF22X (134)
# CHECK: Type: R_IA64_LDXMOV (135)
# CHECK: Type: R_IA64_TPREL14 (145)
# CHECK: Type: R_IA64_TPREL22 (146)
# CHECK: Type: R_IA64_TPREL64I (147)
# CHECK: Type: R_IA64_TPREL64MSB (150)
# CHECK: Type: R_IA64_TPREL64LSB (151)
# CHECK: Type: R_IA64_LTOFF_TPREL22 (154)
# CHECK: Type: R_IA64_DTPMOD64MSB (166)
# CHECK: Type: R_IA64_DTPMOD64LSB (167)
# CHECK: Type: R_IA64_LTOFF_DTPMOD22 (170)
