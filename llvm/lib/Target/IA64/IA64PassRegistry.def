//===----------------------------------------------------------------------===//
//
// This file is used as the registry of passes that are part of the IA64
// backend.
//
//===----------------------------------------------------------------------===//

// NOTE: NO INCLUDE GUARD DESIRED!

#ifndef FUNCTION_PASS
#define FUNCTION_PASS(NAME, CREATE_PASS)
#endif
FUNCTION_PASS("ia64-defer-math-errno", IA64DeferMathErrnoPass())
FUNCTION_PASS("ia64-load-reuse", IA64LoadReusePass())
FUNCTION_PASS("ia64-loop-alias-versioning", IA64LoopAliasVersioningPass())
FUNCTION_PASS("ia64-memmove-versioning", IA64MemmoveVersioningPass())
FUNCTION_PASS("ia64-merge-byte-stores", IA64MergeByteStoresPass())
FUNCTION_PASS("ia64-mul-recurrence", IA64MulRecurrencePass())
FUNCTION_PASS("ia64-speculate-chases", IA64SpeculateChasesPass())
FUNCTION_PASS("ia64-widen-byte-ops", IA64WidenByteOpsPass())
#undef FUNCTION_PASS
