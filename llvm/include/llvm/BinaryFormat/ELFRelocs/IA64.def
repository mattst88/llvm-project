ELF_RELOC(R_IA64_GPREL64I,       0x2b)
ELF_RELOC(R_IA64_GPREL32MSB,     0x2c)
ELF_RELOC(R_IA64_GPREL32LSB,     0x2d)
ELF_RELOC(R_IA64_GPREL64MSB,     0x2e)
ELF_RELOC(R_IA64_GPREL64LSB,     0x2f)
