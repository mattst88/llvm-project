#ifndef ELF_RELOC
#error "ELF_RELOC must be defined"
#endif

// Relocation numbers from the Itanium Processor-specific ABI (Intel document
// 245370), section 4.3.  The MSB forms are used by big-endian systems (HP-UX);
// Linux uses the LSB ones.
ELF_RELOC(R_IA64_NONE,           0x00)
ELF_RELOC(R_IA64_IMM14,          0x21)
ELF_RELOC(R_IA64_IMM22,          0x22)
ELF_RELOC(R_IA64_IMM64,          0x23)
ELF_RELOC(R_IA64_DIR32MSB,       0x24)
ELF_RELOC(R_IA64_DIR32LSB,       0x25)
